# Normalize text files to LF in the repository.
* text=auto eol=lf

# Explicit text-file rules.
*.editorconfig text eol=lf
*.gitattributes text eol=lf
*.lua text eol=lf
*.ps1 text eol=lf
*.psm1 text eol=lf
*.psd1 text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.sh text eol=lf

# Preserve binary files without line-ending conversion.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
